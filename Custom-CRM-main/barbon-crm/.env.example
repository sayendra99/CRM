# Existing local Preact app does not read these values.
# The new web/ app uses the NEXT_PUBLIC_* values in web/.env.example.
# Edge Functions use secrets configured in Supabase, never committed here.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-the-anon-key
# Supabase secrets configured remotely, not in this file:
# SUPABASE_SERVICE_ROLE_KEY=
# BACKUP_ENCRYPTION_KEY=
